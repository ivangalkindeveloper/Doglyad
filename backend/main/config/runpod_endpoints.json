{
  "_comment": [
    "Желаемое состояние serverless-эндпоинтов RunPod. Применяется через `make runpod-apply`.",
    "Ключи в `endpoints` обязаны совпадать с id моделей из ultrasound_examination_neural_models.json.",
    "`defaults` подмешивается в каждый эндпоинт; `env` объединяется по ключам (эндпоинт перекрывает default).",
    "Секреты пишутся как ${VAR} и подставляются из backend/main/secrets/.env — в этот файл они не попадают.",
    "Имена полей — как в REST API RunPod: https://rest.runpod.io/v1",
    "Список допустимых gpuTypeIds: https://docs.runpod.io/references/gpu-types"
  ],

  "defaults": {
    "imageName": "runpod/worker-v1-vllm:v2.23.0",
    "containerDiskInGb": 30,

    "env": {
      "MAX_MODEL_LEN": "16384",
      "LIMIT_MM_PER_PROMPT": "image=10",
      "MAX_NUM_SEQS": "16",
      "GPU_MEMORY_UTILIZATION": "0.90",
      "TENSOR_PARALLEL_SIZE": "1",
      "TRUST_REMOTE_CODE": "false",
      "ENABLE_PREFIX_CACHING": "true",
      "HF_TOKEN": "${HF_TOKEN}"
    },

    "gpuCount": 1,
    "workersMin": 1,
    "workersMax": 3,
    "scalerType": "QUEUE_DELAY",
    "scalerValue": 4,
    "idleTimeout": 30,
    "executionTimeoutMs": 600000,
    "flashboot": true
  },

  "endpoints": {
    "google/medgemma-4b-it": {
      "env": {
        "MODEL_NAME": "google/medgemma-4b-it"
      },
      "gpuTypeIds": ["NVIDIA RTX A5000", "NVIDIA A40", "NVIDIA RTX A6000"]
    },

    "google/medgemma-1.5-4b-it": {
      "env": {
        "MODEL_NAME": "google/medgemma-1.5-4b-it"
      },
      "gpuTypeIds": ["NVIDIA RTX A5000", "NVIDIA A40", "NVIDIA RTX A6000"]
    },

    "google/medgemma-27b-it": {
      "env": {
        "MODEL_NAME": "google/medgemma-27b-it"
      },
      "gpuTypeIds": ["NVIDIA A100 80GB PCIe", "NVIDIA A100-SXM4-80GB"],
      "containerDiskInGb": 80
    }
  }
}
