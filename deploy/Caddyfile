# Домен приходит из переменной DOMAIN — файл общий для обеих main-машин.
#
# Сертификат Caddy получает и продлевает сам: для настоящего домена — через
# Let's Encrypt, для `localhost` — свой внутренний, что и позволяет проверить
# всю связку локально, до покупки виртуалки.
{$DOMAIN} {
	# Имя backend_main — это имя сервиса в docker-compose.yml; Compose резолвит
	# его во внутренней сети. Порт 8000 наружу не опубликован.
	reverse_proxy backend_main:8000
}
